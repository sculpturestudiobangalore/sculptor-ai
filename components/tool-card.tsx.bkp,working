            // Handler for PDF Generation/Download
            const downloadQuotationPDF = async (q: any) => {
                // 1. Get Items (handle both camelCase items and snake_case line_items)
                const items = q.line_items || q.items || [];

                // 2. Resolve Client Name
                // The list tool returns client_name at top level, or nested inside clients object
                const clientName =
                    q.clientName ||
                    q.client_name ||
                    (q.clients && q.clients.name) ||
                    "";

