export default function ToolCard({ toolName, input, output, error, onAction }: ToolCardProps) {
    const outputTyped = output as GenericSuccessOutput

    switch (toolName) {
        // ========================================================================
        // CLIENT TOOLS
        // ========================================================================
        case 'listClientsTool':
            return <ClientListCard output={output as ListClientsOutput | undefined} />

        case 'getClientTool': {
            const o = output as { success: boolean; client?: ClientCard; error?: string }
            if (!o?.success || !o.client) {
                return (
                    <div className={cn(baseCardStyle, 'border-rose-400/30 bg-rose-500/10 text-rose-100')}>
                        <p className="text-sm text-white/70">{o?.error || 'Client not found'}</p>
                    </div>
                )
            }

            return <ClientCardComponent client={o.client} onAction={onAction} />
        }




        case 'validateClientDataTool': {
            const o = output as { success: boolean; validation?: any; error?: string }
            if (!o?.success) {
                return (
                    <div className={cn(baseCardStyle, 'border-rose-400/30 bg-rose-500/10 text-rose-100')}>
                        <SectionHeader eyebrow="Validation" title="Validation failed" />
                        <p className="mt-3 text-sm text-rose-100/80">{o?.error}</p>
                    </div>
                )
            }
            const v = o.validation
            return (
                <div className={baseCardStyle}>
                    <SectionHeader eyebrow="Client validation" title={`${v?.completenessScore || 0}% Complete`} />
                    <div className="mt-4 space-y-3">
                        {v?.errors && v.errors.length > 0 && (
                            <div className="rounded-lg border border-rose-400/30 bg-rose-500/10 p-3">
                                <div className="text-xs font-medium text-rose-200">Errors</div>
                                <ul className="mt-2 space-y-1 text-xs text-rose-100/80">
                                    {v.errors.map((err: string, i: number) => (
                                        <li key={i}>• {err}</li>
                                    ))}
                                </ul>
                            </div>
                        )}
                        {v?.warnings && v.warnings.length > 0 && (
                            <div className="rounded-lg border border-amber-400/30 bg-amber-500/10 p-3">
                                <div className="text-xs font-medium text-amber-200">Warnings</div>
                                <ul className="mt-2 space-y-1 text-xs text-amber-100/80">
                                    {v.warnings.map((warn: string, i: number) => (
                                        <li key={i}>• {warn}</li>
                                    ))}
                                </ul>
                            </div>
                        )}
                        {v?.missingFields && v.missingFields.length > 0 && (
                            <div className="rounded-lg border border-white/10 bg-white/5 p-3">
                                <div className="text-xs font-medium text-white/80">Missing Fields</div>
                                <div className="mt-2 flex flex-wrap gap-2">
                                    {v.missingFields.map((field: string, i: number) => (
                                        <span key={i} className="rounded bg-white/10 px-2 py-1 text-xs text-white/60">
                                            {field}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            )
        }

        // ========================================================================
        // PROJECT TOOLS
        // ========================================================================
        case 'listProjectsTool':
            return <ProjectsCard output={output as ListProjectsOutput | undefined} onAction={onAction} />

        case 'getProjectDetailsTool':
        case 'getProjectTool': {
            const o = output as ProjectDetailsOutput | undefined
            if (o?.multipleMatches && o.matches) {
                return (
                    <div className={baseCardStyle}>
                        <SectionHeader eyebrow="Project search" title="Multiple projects found" />
                        <ul className="mt-4 space-y-2 text-sm text-white/85">
                            {o.matches.map((m) => (
                                <li key={m.id} className="flex items-center justify-between rounded-lg border border-white/10 bg-white/5 p-3">
                                    <span>{m.name}</span>
                                    <span className="text-xs text-white/60">{m.status || '—'}</span>
                                </li>
                            ))}
                        </ul>
                        <p className="mt-3 text-xs text-white/60">Please specify the exact project ID to continue.</p>
                    </div>
                )
            }

            // Filter out completed tasks before passing to ProjectDetailsCard
            const allTasks = (o?.project as any)?.tasks?.list || [];
            const pendingTasks = allTasks.filter((task: any) => task.status !== 'completed');

            return <ProjectDetailsCard
                project={{
                    ...(o?.project as any),
                    tasks: pendingTasks,  // ← Pass only pending tasks
                    materials: (o?.project as any)?.materials || []
                }}
                onAction={onAction}
            />
        }


        case 'estimateProjectCostTool':
            return <CostEstimateCard output={output as any} />

        case 'getProjectProgressTool': {
            const o = output as { success: boolean; progress?: any; error?: string }
            if (!o?.success) {
                return (
                    <div className={cn(baseCardStyle, 'border-rose-400/30 bg-rose-500/10 text-rose-100')}>
                        <SectionHeader eyebrow="Progress" title="Could not fetch progress" />
                        <p className="mt-3 text-sm text-rose-100/80">{o?.error}</p>
                    </div>
                )
            }
            const p = o.progress
            return (
                <div className={baseCardStyle}>
                    <SectionHeader eyebrow="Project progress" title={`${p?.percentage || 0}% Complete`} />
                    <div className="mt-4 space-y-3 text-sm">
                        <div className="flex items-center justify-between">
                            <span className="text-white/60">Tasks completed</span>
                            <span className="font-medium text-white">{p?.completedTasks || 0} of {p?.totalTasks || 0}</span>
                        </div>
                        {p?.nextSteps && (
                            <div className="rounded-lg border border-white/10 bg-white/5 p-3">
                                <div className="text-xs font-medium text-white/80">Next Steps</div>
